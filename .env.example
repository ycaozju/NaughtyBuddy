# Copy to .env only when changing defaults. Local mode needs no cloud account.
BABYBOT_LLM_PROVIDER=local
BABYBOT_LLM_URL=http://127.0.0.1:8081/v1
BABYBOT_SESSION_MINUTES=10
BABYBOT_DAILY_MINUTES=20
BABYBOT_MAX_CONNECTIONS=4
BABYBOT_MAX_INFLIGHT=2
BABYBOT_TURN_TIMEOUT=12
BABYBOT_MODEL_TIMEOUT=8
BABYBOT_REVIEW_TIMEOUT=4
BABYBOT_SPEECH_THREADS=2
BABYBOT_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
BABYBOT_SECURE_COOKIE=0
# Optional cloud text adapter: qwen / doubao / deepseek.
# Requires guardian review of vendor age/privacy terms before children's use.
# Speech and independent moderation still use local models; no automatic failover.
# BABYBOT_CLOUD_MODEL=your-explicit-model-id
# BABYBOT_CLOUD_API_KEY=your-secret-key
# Credentials are generated in .runtime/credentials.json (permissions 0600).
# Override only with different, strong values of at least six characters:
# BABYBOT_FAMILY_CODE=
# BABYBOT_PARENT_PIN=
